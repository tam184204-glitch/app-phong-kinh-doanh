# Cấu hình App Phòng Kinh doanh — chép thành .env rồi điền (không đưa .env lên git)
PORT=3500
# 127.0.0.1 = chỉ máy này; 0.0.0.0 = cho máy khác trong mạng truy cập
HOST=127.0.0.1
DATABASE_URL=postgresql://user:matkhau@localhost:5432/ctg_kinhdoanh
# Mật khẩu mặc định khi tạo / đặt lại tài khoản (bắt buộc đổi ở lần đăng nhập đầu)
DEFAULT_PW=

# AI tra cứu (Claude) — bỏ trống để tắt
ANTHROPIC_API_KEY=

# Khách tự đổ về từ Website / Messenger / Zalo: POST /api/leads kèm header X-Lead-Token = LEAD_TOKEN (bỏ trống để tắt)
LEAD_TOKEN=
# Tên đăng nhập nhân viên nhận khách tự động (bỏ trống = chưa giao, Trưởng phòng phân công)
LEAD_OWNER=

# Facebook Messenger (Page) → Khách hàng tiềm năng. URL gọi lại khai báo bên Meta: https://<tên miền>/api/fb/webhook
# FB_VERIFY_TOKEN: chuỗi tự đặt, nhập giống hệt ở ô «Verify token» bên Meta
FB_VERIFY_TOKEN=
# App Dashboard → App settings → Basic → App secret
FB_APP_SECRET=
# Page Access Token dài hạn (quyền pages_messaging, pages_manage_metadata, pages_show_list)
FB_PAGE_TOKEN=
# ID trang Facebook (tùy chọn — điền thì chỉ nhận tin của trang này)
FB_PAGE_ID=

# Chạy thử không cần đăng nhập (vào thẳng bằng NO_LOGIN_USER, đổi vai trò ở menu tên người dùng). Vận hành thật: xóa 2 dòng này
NO_LOGIN=1
NO_LOGIN_USER=thu.truongphong
